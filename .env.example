# Copy this file to .env and keep the real token only in the local .env file.
DOLPHIN_API_TOKEN=replace-with-your-token
DOLPHIN_API_BASE=https://anty-api.com
DOLPHIN_LOCAL_API=http://localhost:3001
DOLPHIN_AUTOMATION=1
FFMPEG_PATH=ffmpeg
PORT=3030
# Keep the panel available only from this computer by default.
CREATOR_FLOW_HOST=127.0.0.1
